<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="x_bot">
  <!-- Base velocity commands and MID360/IMU are handled by the backend system.
       No simulator odometry, navigation TF or 2D scan publisher. -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/x_bot/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
